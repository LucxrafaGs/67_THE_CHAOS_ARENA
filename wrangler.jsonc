{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "67-the-chaos-arena",
  "account_id": "42d8747e1e9872237fa8d071950ab394",
  "compatibility_date": "2026-10-14",
  // Servidor online: Worker + Durable Objects (salas e lista de salas)
  "main": "server/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Só a API passa pelo Worker; o resto (o jogo) é servido direto, sem custo de requisição
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "SOCIAL", "class_name": "Social" }
    ]
  },
  // Plano gratuito: apenas Durable Objects com SQLite
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] },
    { "tag": "v2", "new_sqlite_classes": ["Social"] }
  ],
  "observability": { "enabled": true }
}
